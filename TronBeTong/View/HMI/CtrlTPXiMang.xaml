        <StackPanel Orientation="Horizontal" Margin="0 190 0 0">
            <local:CtrlWeightScale x:Name="WSCements1" ZFill="#80dfdf00" HorizontalAlignment="Center" Margin="60 10 60 0" Width="120"/>
            <local:CtrlWeightScale x:Name="WSCements2" ZFill="#80dfdf00" HorizontalAlignment="Center" Margin="40 10 20 0" Width="120"/>
