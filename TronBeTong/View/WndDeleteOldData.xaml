<Window x:Class="TronBeTongV3.View.WndDeleteOldData"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TronBeTongV3.View"
        mc:Ignorable="d"
        Title="WndDeleteOldData" Height="450" Width="800"
        WindowStartupLocation="CenterScreen" Background="WhiteSmoke">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml"/>
                <ResourceDictionary Source="../Styles/BootstrapButtons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <StackPanel Margin="3 3 0 3">
            <Button x:Name="BtThongKe" Content="Thống kê" Style="{StaticResource BtnPrimary}"
                    Click="BtThongKe_Click"/>
            <Separator Margin="0 3"/>
            <TextBlock Text="Tháng"/>
            <ComboBox x:Name="CboDeletable"/>
            <CheckBox x:Name="ChkDeleteDonHang" Content="Xóa đơn hàng" IsChecked="True" Margin="0 3"/>
            <Button x:Name="BtDelete" Content="Xóa" Style="{StaticResource BtnDanger}" IsEnabled="False"
                    Click="BtDelete_Click"/>
        </StackPanel>
        <ListView x:Name="Lv" Margin="3" ItemsSource="{Binding TKDuLieu}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Năm" DisplayMemberBinding="{Binding Year}"/>
                    <GridViewColumn Header="Tháng" DisplayMemberBinding="{Binding Month}"/>
                    <GridViewColumn Header="Số đơn" DisplayMemberBinding="{Binding TongDon}"/>
                    <GridViewColumn Header="Số phiếu" DisplayMemberBinding="{Binding TongPhieu}"/>
                    <GridViewColumn Header="Số mẻ" DisplayMemberBinding="{Binding TongMe}"/>
                    <GridViewColumn Header="Tổng m3" DisplayMemberBinding="{Binding M3}"/>
                </GridView>
            </ListView.View>
        </ListView>

    </DockPanel>
</Window>
